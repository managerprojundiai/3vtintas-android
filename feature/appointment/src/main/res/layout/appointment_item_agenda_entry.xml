<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/agenda_entry_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/appointment_space_small"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    app:cardCornerRadius="@dimen/appointment_card_radius"
    app:cardElevation="0dp"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/appointment_space_small">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/agenda_entry_type"
            style="@style/TextAppearance.Material3.LabelSmall"
            android:layout_width="@dimen/agenda_entry_type_width"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="2" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appointment_space_small"
            android:layout_weight="1"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/agenda_entry_title"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/agenda_entry_meta"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/appointment_space_tiny"
                android:ellipsize="end"
                android:maxLines="1" />
        </LinearLayout>

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/agenda_entry_amount"
            style="@style/TextAppearance.Material3.TitleSmall"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/appointment_space_small"
            android:gravity="end"
            android:maxLines="1"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
