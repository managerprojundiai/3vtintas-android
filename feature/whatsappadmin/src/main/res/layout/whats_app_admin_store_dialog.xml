<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/store_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#071B3D"
            android:textSize="21sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/store_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#45617F"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/whatsapp_admin_mode_heading"
            android:textColor="#071B3D"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/mode"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:contentDescription="@string/whatsapp_admin_mode_heading" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/save_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/whatsapp_admin_save_mode" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#D7E2EF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whatsapp_admin_meta_heading"
            android:textColor="#071B3D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/meta_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#45617F" />

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="@string/whatsapp_admin_phone_number_id">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/meta_phone_number_id"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="120" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/whatsapp_admin_phone_number_optional">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/meta_phone_number"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:importantForAutofill="no"
                android:inputType="phone"
                android:maxLength="15" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/meta_validation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/whatsapp_admin_meta_validation"
            android:textColor="#B3261E"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/configure_meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/whatsapp_admin_configure_meta" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="20dp"
            android:background="#D7E2EF" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/whatsapp_admin_evolution_heading"
            android:textColor="#071B3D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/evolution_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#45617F" />

        <TextView
            android:id="@+id/evolution_instance"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#071B3D"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/provision_evolution"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/whatsapp_admin_provision_evolution" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/refresh_evolution"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/whatsapp_admin_refresh_evolution"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/request_qr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/whatsapp_admin_request_qr"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
