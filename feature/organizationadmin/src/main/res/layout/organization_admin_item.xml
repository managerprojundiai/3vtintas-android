<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@android:color/white"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/organization_name"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="#071B3D"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/organization_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#E7F1FF"
            android:paddingHorizontal="10dp"
            android:paddingVertical="5dp"
            android:textColor="#0A55B6"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/organization_slug"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#45617F"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/organization_members"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#243D5A"
        android:textSize="14sp" />
</LinearLayout>
