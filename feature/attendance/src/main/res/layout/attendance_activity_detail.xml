<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/attendance_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/attendance_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:navigationIcon="@drawable/attendance_ic_arrow_back"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/attendance_back"
        app:subtitle="@string/attendance_detail_subtitle"
        app:title="@string/attendance_detail_title" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/attendance_screen_padding"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/attendance_detail_toolbar">

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/attendance_detail_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:indeterminate="true"
            android:visibility="invisible" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/attendance_detail_realtime_status"
            style="@style/TextAppearance.Material3.LabelMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:paddingVertical="@dimen/attendance_space_small"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/attendance_detail_notice"
            style="@style/TextAppearance.Material3.BodyMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityLiveRegion="polite"
            android:padding="@dimen/attendance_space_small"
            android:visibility="gone" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/attendance_detail_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/attendance_space_small"
            android:visibility="gone"
            app:cardUseCompatPadding="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/attendance_space_medium">

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/attendance_detail_customer"
                    style="@style/TextAppearance.Material3.TitleLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/attendance_detail_channel"
                    style="@style/TextAppearance.Material3.LabelLarge"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/attendance_space_small"
                    android:textColor="?attr/colorPrimary" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/attendance_detail_owner"
                    style="@style/TextAppearance.Material3.BodyMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/attendance_space_small" />

                <com.google.android.material.textview.MaterialTextView
                    android:id="@+id/attendance_detail_meta"
                    style="@style/TextAppearance.Material3.BodySmall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/attendance_space_small"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:id="@+id/attendance_management_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/attendance_space_small"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/attendance_management_open"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:enabled="false"
                    android:text="@string/attendance_management_open" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/attendance_management_progress"
                    android:layout_width="@dimen/attendance_reply_progress_size"
                    android:layout_height="@dimen/attendance_reply_progress_size"
                    android:layout_marginStart="@dimen/attendance_space_small"
                    android:contentDescription="@string/attendance_management_progress"
                    android:indeterminate="true"
                    android:visibility="invisible" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/attendance_management_retry"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/attendance_retry"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/attendance_management_status"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="@dimen/attendance_space_small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendance_detail_load_more"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/attendance_detail_load_more"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/attendance_detail_empty_group"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/attendance_detail_empty_title"
                style="@style/TextAppearance.Material3.TitleLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/attendance_detail_loading" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/attendance_detail_empty_message"
                style="@style/TextAppearance.Material3.BodyMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/attendance_space_small"
                android:gravity="center"
                android:text="@string/attendance_detail_loading_message" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/attendance_detail_retry"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/attendance_space_medium"
                android:text="@string/attendance_retry"
                android:visibility="gone" />
        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/attendance_detail_messages"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:paddingVertical="@dimen/attendance_space_small"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/attendance_reply_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/attendance_reply_input_layout"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:counterEnabled="true"
                app:counterMaxLength="3500"
                app:hintEnabled="true">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/attendance_reply_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:freezesText="false"
                    android:hint="@string/attendance_reply_hint"
                    android:inputType="textCapSentences|textMultiLine"
                    android:maxLength="3500"
                    android:maxLines="6"
                    android:minLines="2"
                    android:saveEnabled="false" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/attendance_reply_send"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/attendance_reply_send" />

                <com.google.android.material.progressindicator.CircularProgressIndicator
                    android:id="@+id/attendance_reply_progress"
                    android:layout_width="@dimen/attendance_reply_progress_size"
                    android:layout_height="@dimen/attendance_reply_progress_size"
                    android:layout_marginStart="@dimen/attendance_space_small"
                    android:contentDescription="@string/attendance_reply_progress"
                    android:indeterminate="true"
                    android:visibility="invisible" />
            </LinearLayout>

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/attendance_reply_status"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite"
                android:paddingVertical="@dimen/attendance_space_small"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/attendance_detail_refresh"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:enabled="false"
            android:text="@string/attendance_detail_refresh" />

        <com.google.android.material.textview.MaterialTextView
            style="@style/TextAppearance.Material3.BodySmall"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/attendance_space_small"
            android:text="@string/attendance_detail_privacy_notice"
            android:textColor="?attr/colorOnSurfaceVariant" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
