<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/debug_agent_action_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/debug_agent_action_review_title"
        android:textAppearance="?attr/textAppearanceHeadlineSmall" />

    <TextView
        android:id="@+id/debug_agent_action_decision"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/debug_agent_action_no_decision"
        android:textAppearance="?attr/textAppearanceBodyLarge" />

    <Button
        android:id="@+id/debug_agent_action_reopen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/debug_agent_action_reopen" />

</LinearLayout>
