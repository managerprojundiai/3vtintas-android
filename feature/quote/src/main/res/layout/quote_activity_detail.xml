<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/quote_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:navigationIcon="@drawable/quote_ic_arrow_back"
        app:navigationContentDescription="@string/quote_back"
        app:title="@string/quote_detail_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/quote_detail_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/quote_screen_padding">

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quote_detail_headline"
                style="@style/TextAppearance.Material3.HeadlineSmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quote_detail_meta"
                style="@style/TextAppearance.Material3.BodyLarge"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_small" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quote_detail_items"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_medium"
                android:textIsSelectable="true" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_edit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_medium"
                android:text="@string/quote_edit_button"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_small"
                android:text="@string/quote_status_button"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_duplicate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_small"
                android:text="@string/quote_duplicate_button"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_create_order"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_small"
                android:text="@string/quote_create_order_button"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_pdf"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_small"
                android:text="@string/quote_pdf_button"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quote_pdf_note"
                style="@style/TextAppearance.Material3.BodySmall"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_small"
                android:text="@string/quote_pdf_cache_note"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quote_status_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_medium"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/quote_detail_error"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/quote_space_medium"
                android:textColor="?attr/colorError" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
