<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/order_detail_root"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar android:id="@+id/order_detail_toolbar"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="?attr/actionBarSize"
        android:navigationIcon="@drawable/order_ic_arrow_back" app:navigationContentDescription="@string/order_back"
        app:title="@string/order_detail_title" app:subtitle="@string/order_detail_subtitle"
        app:layout_constraintTop_toTopOf="parent" app:layout_constraintStart_toStartOf="parent" app:layout_constraintEnd_toEndOf="parent" />
    <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/order_detail_progress"
        android:layout_width="match_parent" android:layout_height="wrap_content" android:indeterminate="true"
        android:visibility="invisible" app:layout_constraintTop_toBottomOf="@id/order_detail_toolbar" />
    <LinearLayout android:id="@+id/order_detail_error" android:layout_width="match_parent" android:layout_height="0dp"
        android:orientation="vertical" android:gravity="center" android:padding="@dimen/order_space_large" android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/order_detail_progress" app:layout_constraintBottom_toBottomOf="parent">
        <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_error_message"
            style="@style/TextAppearance.Material3.BodyLarge" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:gravity="center" android:accessibilityLiveRegion="assertive" />
        <com.google.android.material.button.MaterialButton android:id="@+id/order_detail_retry"
            android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="@dimen/order_space_medium"
            android:text="@string/order_retry" />
    </LinearLayout>
    <androidx.core.widget.NestedScrollView android:id="@+id/order_detail_content"
        android:layout_width="match_parent" android:layout_height="0dp" android:fillViewport="true" android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/order_detail_progress" app:layout_constraintBottom_toBottomOf="parent">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:padding="@dimen/order_screen_padding">
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_reference"
                style="@style/TextAppearance.Material3.HeadlineSmall" android:layout_width="match_parent" android:layout_height="wrap_content" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_status"
                style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" android:textColor="?attr/colorPrimary" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_total"
                style="@style/TextAppearance.Material3.HeadlineMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_medium" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_meta"
                style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_payment"
                style="@style/TextAppearance.Material3.BodyLarge" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_pricing"
                style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_action_notice"
                style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_medium" android:accessibilityLiveRegion="assertive"
                android:visibility="gone" />
            <LinearLayout android:id="@+id/order_actions" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="@dimen/order_space_large"
                android:orientation="vertical" android:visibility="gone">
                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:text="@string/order_actions_title" />
                <com.google.android.material.textview.MaterialTextView
                    style="@style/TextAppearance.Material3.BodySmall" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/order_space_small"
                    android:text="@string/order_actions_scope_note" />
                <com.google.android.material.button.MaterialButton android:id="@+id/order_action_confirm"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/order_space_medium" android:text="@string/order_action_confirm" />
                <com.google.android.material.button.MaterialButton android:id="@+id/order_action_start"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/order_space_small" android:text="@string/order_action_start" />
                <com.google.android.material.button.MaterialButton android:id="@+id/order_action_complete"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/order_space_small" android:text="@string/order_action_complete" />
                <com.google.android.material.button.MaterialButton android:id="@+id/order_action_payment"
                    style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/order_space_small"
                    android:text="@string/order_action_payment" />
                <com.google.android.material.button.MaterialButton android:id="@+id/order_action_cancel"
                    style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent"
                    android:layout_height="wrap_content" android:layout_marginTop="@dimen/order_space_small"
                    android:text="@string/order_action_cancel" />
            </LinearLayout>
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_customer_title"
                style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_large" android:text="@string/order_section_customer" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_customer"
                style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" android:textIsSelectable="true" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_delivery_title"
                style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_large" android:text="@string/order_section_delivery" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_delivery"
                style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" android:textIsSelectable="true" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_items_title"
                style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_large" android:text="@string/order_section_items" />
            <LinearLayout android:id="@+id/order_detail_items" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_notes_title"
                style="@style/TextAppearance.Material3.TitleMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_large" android:text="@string/order_section_notes" />
            <com.google.android.material.textview.MaterialTextView android:id="@+id/order_detail_notes"
                style="@style/TextAppearance.Material3.BodyMedium" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/order_space_small" android:paddingBottom="@dimen/order_space_large" android:textIsSelectable="true" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
