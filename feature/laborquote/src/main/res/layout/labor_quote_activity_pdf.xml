<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/labor_quote_pdf_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:navigationIcon="@drawable/labor_quote_ic_arrow_back"
        android:title="@string/labor_quote_pdf_title"
        app:navigationContentDescription="@string/labor_quote_back" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/labor_quote_pdf_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <ScrollView
        android:id="@+id/labor_quote_pdf_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ImageView
            android:id="@+id/labor_quote_pdf_image"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:contentDescription="@string/labor_quote_pdf_title" />
    </ScrollView>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/labor_quote_pdf_page"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="@dimen/labor_quote_space_small" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/labor_quote_space_small">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/labor_quote_pdf_previous"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/labor_quote_pdf_previous" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/labor_quote_pdf_next"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/labor_quote_pdf_next" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/labor_quote_pdf_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/labor_quote_pdf_share" />
    </LinearLayout>

    <com.google.android.material.textview.MaterialTextView
        android:id="@+id/labor_quote_pdf_error"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/labor_quote_space_small"
        android:textColor="?attr/colorError" />
</LinearLayout>
