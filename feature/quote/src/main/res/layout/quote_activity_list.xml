<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/quote_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:navigationIcon="@drawable/quote_ic_arrow_back"
        app:navigationContentDescription="@string/quote_back"
        app:title="@string/quote_list_title"
        app:subtitle="@string/quote_list_subtitle" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/quote_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="invisible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/quote_screen_padding">

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/quote_search_hint">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/quote_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLength="120"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/quote_view_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/quote_space_small"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_view_active"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quote_view_active" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_view_history"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quote_view_history" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quote_view_all"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/quote_view_all" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quote_search_action"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quote_search_button" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/quote_notice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/quote_space_small"
            android:accessibilityLiveRegion="polite"
            android:textColor="?attr/colorError" />

        <ListView
            android:id="@+id/quote_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/quote_space_small"
            android:layout_weight="1"
            android:dividerHeight="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quote_load_more"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quote_load_more"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/quote_new"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/quote_new_button" />
    </LinearLayout>
</LinearLayout>
