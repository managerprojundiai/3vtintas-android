    <string name="agent_action_send_revalidation_notice">Antes do envio, o servidor verificará novamente permissão, revisão, preços e estoque.</string>
    <string name="agent_action_create_revalidation_notice">Ao confirmar, o servidor verificará novamente sua permissão e exigirá que cliente, itens, quantidades, preços, validade e observações ainda sejam exatamente os mesmos desta revisão.</string>
    <string name="agent_action_amend_revalidation_notice">Ao confirmar, o servidor relerá permissão, revisão, cliente, preços e estoque. A alteração só será aplicada se o orçamento e este cálculo ainda forem exatamente os mesmos.</string>
    <string name="agent_action_attendance_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a loja, a atribuição e a revisão da conversa. Se uma nova mensagem chegar ou o atendimento mudar, nada será enviado.</string>
    <string name="agent_action_appointment_create_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, o responsável, a loja, o cliente e a disponibilidade do horário. Se houver conflito, nada será criado.</string>
    <string name="agent_action_appointment_reschedule_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a revisão atual e a disponibilidade do novo horário. Se o compromisso mudou ou houver conflito, nada será alterado.</string>
    <string name="agent_action_appointment_cancel_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a revisão e o estado atual do compromisso. Se ele mudou ou já terminou, nada será cancelado.</string>
    <string name="agent_action_delivery_start_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a loja, sua atribuição, a revisão e o estado atual. Se a entrega mudou ou deixou de ser sua, nada será iniciado.</string>
    <string name="agent_action_delivery_complete_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, sua atribuição, a revisão e se a entrega ainda está em trânsito. Se algo mudou, nada será concluído.</string>
    <string name="agent_action_order_confirm_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a loja, a revisão e se o pedido ainda está pendente. Se algo mudou, nada será confirmado.</string>
    <string name="agent_action_order_start_fulfillment_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a loja, a revisão e se o pedido ainda está confirmado. Se algo mudou, a separação não será iniciada.</string>
    <string name="agent_action_order_complete_revalidation_notice">Ao confirmar, o servidor verificará novamente seu acesso, a loja, a revisão e se o pedido ainda está em separação. Se algo mudou, o pedido não será concluído.</string>
