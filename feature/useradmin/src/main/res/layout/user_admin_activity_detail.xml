<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/user_admin_detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/user_admin_detail_toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:navigationIcon="@drawable/user_admin_ic_arrow_back"
        android:paddingHorizontal="@dimen/user_admin_space_small"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:navigationContentDescription="@string/user_admin_back"
        app:title="@string/user_admin_detail_title" />

    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/user_admin_detail_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:indeterminate="true"
        android:visibility="invisible"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_admin_detail_toolbar" />

    <LinearLayout
        android:id="@+id/user_admin_detail_error_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/user_admin_screen_padding"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_admin_detail_progress">
        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/user_admin_detail_error"
            style="@style/TextAppearance.Material3.BodyLarge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/user_admin_detail_retry"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/user_admin_space_medium"
            android:text="@string/user_admin_retry" />
    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/user_admin_detail_scroll"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/user_admin_detail_progress">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/user_admin_screen_padding">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/user_admin_space_medium">
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/user_admin_detail_name"
                        style="@style/TextAppearance.Material3.HeadlineSmall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/user_admin_detail_email"
                        style="@style/TextAppearance.Material3.BodyLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/user_admin_space_small" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/user_admin_detail_role"
                        style="@style/TextAppearance.Material3.TitleMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/user_admin_space_small"
                        android:textColor="?attr/colorPrimary" />
                    <com.google.android.material.textview.MaterialTextView
                        style="@style/TextAppearance.Material3.LabelLarge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/user_admin_space_medium"
                        android:text="@string/user_admin_assignments" />
                    <com.google.android.material.textview.MaterialTextView
                        android:id="@+id/user_admin_detail_assignments"
                        style="@style/TextAppearance.Material3.BodyMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.textview.MaterialTextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/user_admin_space_small"
                android:text="@string/user_admin_private_notice" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/user_admin_detail_protection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/user_admin_space_small"
                android:text="@string/user_admin_protected"
                android:textColor="?attr/colorPrimary"
                android:visibility="gone" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/user_admin_detail_notice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/user_admin_space_small"
                android:accessibilityLiveRegion="assertive"
                android:textColor="?attr/colorError"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_admin_detail_security_access"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/user_admin_space_medium"
                android:text="@string/user_admin_security_access"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_admin_detail_standard_role"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_admin_standard_role" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_admin_detail_operational_role"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/user_admin_operational_role" />
            <com.google.android.material.button.MaterialButton
                android:id="@+id/user_admin_detail_status"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/user_admin_space_medium"
                android:text="@string/user_admin_block" />
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
